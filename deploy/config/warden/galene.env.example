# /etc/noltbook-warden/galene.env   mode 0600, owned by the warden service user.
#
# GALENE_BASE   loopback admin/API base. Galene runs -insecure behind nginx,
#               so this is plain HTTP on localhost and must never be public.
# GALENE_WS     websocket endpoint the warden hands to browsers.
# GALENE_PUBLIC user-visible group page base.
# GALENE_ADMIN_* administrator credentials for the /galene-api/v0/ endpoints.
#               SECRET. These are the keys to every group on the server.
GALENE_BASE=http://127.0.0.1:8443
GALENE_WS=wss://sfu.example.com/ws
GALENE_PUBLIC=https://sfu.example.com
GALENE_ADMIN_USER=REPLACE_ME
GALENE_ADMIN_PASS=REPLACE_ME
