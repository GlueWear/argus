# /etc/noltbook-warden/turn.env   mode 0600, owned by the warden service user.
#
# TURN_SECRET must equal coturn's static-auth-secret exactly. It is used only
# to compute HMAC-SHA1 REST credentials locally; it is never returned to a
# caller, never logged, and never leaves the host.
TURN_SECRET=REPLACE_ME_MATCHES_COTURN_static-auth-secret
TURN_REALM=turn.example.com
TURN_HOST=turn.example.com
TURN_UDP_PORT=3478
TURN_TCP_PORT=3478
TURN_TLS_PORT=5349
# STUN servers offered to the browser, comma separated.
STUN_URLS=stun:turn.example.com:3478
# Websocket URL handed to browsers in an access grant.
GALENE_WS_PUBLIC=wss://sfu.example.com/ws
